datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. AUTH & ROLES
// ==========================================
enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

model User {
  id           String               @id @default(uuid())
  username     String               @unique
  fullName     String
  passwordHash String
  role         Role                 @default(EMPLOYEE)
  isActive     Boolean              @default(true)
  purchases    PaddyPurchase[]
  dispatches   TruckDispatch[]
  settlements  MillSettlement[]
  payments     PaymentTransaction[]
  expenses     BusinessExpense[]
  auditLogs    AuditLog[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("users")
}

// ==========================================
// 2. MASTER RECORDS
// ==========================================
model Farmer {
  id             String               @id @default(uuid())
  code           String               @unique // e.g. FMR-001
  name           String
  phone          String
  locality       String
  openingBalance Decimal              @default(0) @db.Decimal(14, 2) // +ve: Farmer owed, -ve: Advance/Overpaid
  openingDate    DateTime?
  purchases      PaddyPurchase[]
  advances       FarmerAdvance[]
  harvesterJobs  HarvesterWork[]
  ledgerEntries  LedgerEntry[]
  payments       PaymentTransaction[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("farmers")
}

model RiceMill {
  id             String               @id @default(uuid())
  code           String               @unique // e.g. MIL-001
  name           String
  contactPerson  String?
  phone          String
  location       String
  openingBalance Decimal              @default(0) @db.Decimal(14, 2) // +ve: Mill owes us, -ve: Advance
  dispatches     TruckDispatch[]
  settlements    MillSettlement[]
  contracts      MillContract[]
  ledgerEntries  LedgerEntry[]
  payments       PaymentTransaction[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("rice_mills")
}

model MillContract {
  id             String          @id @default(uuid())
  contractNumber String          @unique
  millId         String
  mill           RiceMill        @relation(fields: [millId], references: [id])
  variety        String
  targetWeightKg Decimal         @db.Decimal(12, 3)
  ratePerKg      Decimal         @db.Decimal(10, 2)
  maxMoisture    Decimal?        @db.Decimal(5, 2)
  status         ContractStatus  @default(OPEN)
  dispatches     TruckDispatch[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("mill_contracts")
}

enum ContractStatus {
  OPEN
  FULFILLED
  CLOSED
}

model HarvesterMachine {
  id            String          @id @default(uuid())
  name          String // Machine model or Plate No.
  operatorName  String
  operatorPhone String?
  workLogs      HarvesterWork[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("harvester_machines")
}

// ==========================================
// 3. PADDY PROCUREMENT & LOTS
// ==========================================
enum RateUnit {
  KG
  QUINTAL // 100 kg
}

model PaddyPurchase {
  id             String   @id @default(uuid())
  purchaseNumber String   @unique // e.g. PUR-2026-0001
  farmerId       String
  farmer         Farmer   @relation(fields: [farmerId], references: [id])
  purchaseDate   DateTime
  variety        String?
  fieldLocation  String?

  sackCount        Int
  grossWeightKg    Decimal @db.Decimal(12, 3)
  sackTareWeightKg Decimal @db.Decimal(12, 3)
  netWeightKg      Decimal @db.Decimal(12, 3)

  rate        Decimal  @db.Decimal(10, 2)
  rateUnit    RateUnit @default(KG)
  totalAmount Decimal  @db.Decimal(14, 2)
  notes       String?

  lot         PaddyLot?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("paddy_purchases")
}

model PaddyLot {
  id                  String               @id @default(uuid())
  lotNumber           String               @unique // e.g. LOT-PUR-2026-0001
  purchaseId          String               @unique
  purchase            PaddyPurchase        @relation(fields: [purchaseId], references: [id])
  initialWeightKg     Decimal              @db.Decimal(12, 3)
  allocatedWeightKg   Decimal              @default(0) @db.Decimal(12, 3)
  remainingWeightKg   Decimal              @db.Decimal(12, 3)
  isExhausted         Boolean              @default(false)
  dispatchAllocations DispatchAllocation[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("paddy_lots")
}

// ==========================================
// 4. HARVESTER WORK & ADVANCES
// ==========================================
enum HarvesterChargeHandling {
  FARMER_DEDUCTION
  COMPANY_EXPENSE
}

model HarvesterWork {
  id             String                  @id @default(uuid())
  workDate       DateTime
  farmerId       String
  farmer         Farmer                  @relation(fields: [farmerId], references: [id])
  machineId      String
  machine        HarvesterMachine        @relation(fields: [machineId], references: [id])
  workQuantity   Decimal                 @db.Decimal(8, 2)
  ratePerUnit    Decimal                 @db.Decimal(10, 2)
  totalCharge    Decimal                 @db.Decimal(12, 2)
  chargeHandling HarvesterChargeHandling
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@map("harvester_works")
}

model FarmerAdvance {
  id        String   @id @default(uuid())
  farmerId  String
  farmer    Farmer   @relation(fields: [farmerId], references: [id])
  date      DateTime @default(now())
  amount    Decimal  @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now())

  @@map("farmer_advances")
}

// ==========================================
// 5. TRUCK DISPATCH & LOGISTICS
// ==========================================
enum DispatchStatus {
  IN_TRANSIT
  DELIVERED
  RECONCILED
}

model TruckDispatch {
  id             String        @id @default(uuid())
  dispatchNumber String        @unique // e.g. DSP-2026-0001
  millId         String
  mill           RiceMill      @relation(fields: [millId], references: [id])
  contractId     String?
  contract       MillContract? @relation(fields: [contractId], references: [id])
  dispatchDate   DateTime
  truckNumber    String
  driverName     String
  driverPhone    String?

  totalSacks    Int
  grossWeightKg Decimal @db.Decimal(12, 3)
  tareWeightKg  Decimal @db.Decimal(12, 3)
  netWeightKg   Decimal @db.Decimal(12, 3)

  transportCost    Decimal @default(0) @db.Decimal(10, 2)
  loadingLaborCost Decimal @default(0) @db.Decimal(10, 2)
  otherExpenses    Decimal @default(0) @db.Decimal(10, 2)

  status      DispatchStatus       @default(IN_TRANSIT)
  allocations DispatchAllocation[]
  settlement  MillSettlement?
  createdById String
  createdBy   User                 @relation(fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("truck_dispatches")
}

model DispatchAllocation {
  id          String        @id @default(uuid())
  dispatchId  String
  dispatch    TruckDispatch @relation(fields: [dispatchId], references: [id])
  lotId       String
  lot         PaddyLot      @relation(fields: [lotId], references: [id])
  allocatedKg Decimal       @db.Decimal(12, 3)
  sacksCount  Int

  @@map("dispatch_allocations")
}

// ==========================================
// 6. MILL RECEIPT & SETTLEMENT
// ==========================================
enum DeductionType {
  WEIGHT_CUT
  SACK_TARE_CUT
  PERCENTAGE_CUT
  PER_UNIT_RATE_CUT
  FIXED_MONEY_CUT
}

model MillSettlement {
  id          String        @id @default(uuid())
  dispatchId  String        @unique
  dispatch    TruckDispatch @relation(fields: [dispatchId], references: [id])
  millId      String
  mill        RiceMill      @relation(fields: [millId], references: [id])
  receiptDate DateTime

  receivedSacks    Int
  receivedWeightKg Decimal @db.Decimal(12, 3)
  shortageWeightKg Decimal @db.Decimal(12, 3) // Dispatched Net - Received Weight

  millRate     Decimal  @db.Decimal(10, 2)
  millRateUnit RateUnit @default(KG)

  deductions MillDeduction[]

  finalAcceptedKg    Decimal @db.Decimal(12, 3)
  grossSettlementNpr Decimal @db.Decimal(14, 2)
  totalDeductionsNpr Decimal @db.Decimal(14, 2)
  netPayableByMill   Decimal @db.Decimal(14, 2)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("mill_settlements")
}

model MillDeduction {
  id           String         @id @default(uuid())
  settlementId String
  settlement   MillSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  name         String
  type         DeductionType
  rateOrValue  Decimal        @db.Decimal(10, 2)
  impactInKg   Decimal?       @db.Decimal(12, 3)
  impactInNpr  Decimal        @db.Decimal(12, 2)

  @@map("mill_deductions")
}

// ==========================================
// 7. FINANCIAL LEDGER & PAYMENTS
// ==========================================
enum PaymentMode {
  CASH
  BANK_TRANSFER
  CHEQUE
  ADJUSTMENT
}

enum PartyType {
  FARMER
  RICE_MILL
}

enum EntryType {
  DEBIT
  CREDIT
}

model PaymentTransaction {
  id              String      @id @default(uuid())
  voucherNumber   String      @unique // e.g. VCH-0001
  paymentDate     DateTime
  partyType       PartyType
  farmerId        String?
  farmer          Farmer?     @relation(fields: [farmerId], references: [id])
  millId          String?
  mill            RiceMill?   @relation(fields: [millId], references: [id])
  amount          Decimal     @db.Decimal(14, 2)
  paymentMode     PaymentMode
  referenceNumber String?
  notes           String?
  createdById     String
  createdBy       User        @relation(fields: [createdById], references: [id])
  createdAt       DateTime    @default(now())

  @@index([farmerId])
  @@index([millId])
  @@map("payment_transactions")
}

model LedgerEntry {
  id              String    @id @default(uuid())
  partyType       PartyType
  farmerId        String?
  farmer          Farmer?   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  millId          String?
  mill            RiceMill? @relation(fields: [millId], references: [id], onDelete: Cascade)
  transactionDate DateTime
  entryType       EntryType // DEBIT or CREDIT
  amount          Decimal   @db.Decimal(14, 2)
  balanceAfter    Decimal   @db.Decimal(14, 2)
  referenceType   String // "PURCHASE", "PAYMENT", "SETTLEMENT", "HARVESTER", "ADJUSTMENT"
  referenceId     String // Foreign ID of the source document
  description     String
  createdAt       DateTime  @default(now())

  @@index([partyType, farmerId, transactionDate])
  @@index([partyType, millId, transactionDate])
  @@map("ledger_entries")
}

// ==========================================
// 8. GENERAL EXPENSES & AUDIT
// ==========================================
model ExpenseCategory {
  id        String            @id @default(uuid())
  name      String            @unique
  expenses  BusinessExpense[]
  createdAt DateTime          @default(now())

  @@map("expense_categories")
}

model BusinessExpense {
  id          String          @id @default(uuid())
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  expenseDate DateTime
  amount      Decimal         @db.Decimal(12, 2)
  paidTo      String?
  notes       String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@map("business_expenses")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String // "CREATE", "UPDATE", "REVERSAL"
  entity    String // "PaddyPurchase", "MillSettlement"
  entityId  String
  oldValues Json?
  newValues Json?
  timestamp DateTime @default(now())

  @@map("audit_logs")
}
